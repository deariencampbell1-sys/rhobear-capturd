{
  "name": "@rhobear/family-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared tokens, fonts, marks, motion, and UI surfaces for the Rhobear family of apps.",
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./fonts": {
      "types": "./dist/fonts/index.d.ts",
      "import": "./dist/fonts/index.js"
    },
    "./marks": {
      "types": "./dist/marks/index.d.ts",
      "import": "./dist/marks/index.js"
    },
    "./motion": {
      "types": "./dist/motion/index.d.ts",
      "import": "./dist/motion/index.js"
    },
    "./motion.css": "./dist/motion/motion.css",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react/*.css": "./dist/react/*.css",
    "./react/*": {
      "types": "./dist/react/*.d.ts",
      "import": "./dist/react/*.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "import": "./dist/native/index.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "import": "./dist/graph/index.js"
    },
    "./graph/draw": {
      "types": "./dist/graph/draw/index.d.ts",
      "import": "./dist/graph/draw/index.js"
    },
    "./graph/editor": {
      "types": "./dist/graph/editor/index.d.ts",
      "import": "./dist/graph/editor/index.js"
    },
    "./graph/views": {
      "types": "./dist/graph/views/index.d.ts",
      "import": "./dist/graph/views/index.js"
    },
    "./graph/export": {
      "types": "./dist/graph/export/index.d.ts",
      "import": "./dist/graph/export/index.js"
    },
    "./graph/execution": {
      "types": "./dist/graph/execution/index.d.ts",
      "import": "./dist/graph/execution/index.js"
    },
    "./tokens.css": "./dist/tokens/tokens.css",
    "./fonts.css": "./dist/fonts/fonts.css"
  },
  "scripts": {
    "extract": "node scripts/extract-tokens.mjs",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs && node test/browser/optional.mjs",
    "prepack": "npm run build",
    "prepare": "node scripts/prepare.mjs",
    "test:browser": "node --test test/browser/motion.browser.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "fontkit": "2.0.4",
    "playwright-core": "1.49.1",
    "png-to-ico": "2.1.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.33.5",
    "typescript": "5.6.3"
  }
}
