# Add to rhobear-vps Caddy. Domain (G2) → this box; Caddy gets the cert automatically.
capturd.rhobear.ai {
    encode zstd gzip
    # video responses can be large; don't buffer them
    reverse_proxy 127.0.0.1:8099 {
        flush_interval -1
    }
    # Rho's brain (/companion/* → rhobear-companion) is proxied by the app itself, on
    # purpose: the embed's contract is a SAME-ORIGIN endpoint. Don't add a handle_path
    # that shadows /companion/* here.
}
